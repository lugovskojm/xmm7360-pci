post_install() {
    dkms add    -m xmm7360-pci -v 1.0.omarchy
    dkms build  -m xmm7360-pci -v 1.0.omarchy
    dkms install -m xmm7360-pci -v 1.0.omarchy

    cat <<'EOM'
==> xmm7360-pci installed.
    • Blacklist the stock iosm driver if it grabs the device first:
        echo "blacklist iosm" | sudo tee /etc/modprobe.d/xmm7360.conf
    • Then reboot (or: sudo rmmod iosm && sudo modprobe xmm7360).
    • To bring up data: sudo /usr/share/xmm7360-pci/rpc/open_xdatachannel.py -a internet
EOM
}

pre_upgrade() {
    dkms remove -m xmm7360-pci -v 1.0.omarchy --all || true
}

post_upgrade() {
    post_install
}

pre_remove() {
    dkms remove -m xmm7360-pci -v 1.0.omarchy --all || true
}
