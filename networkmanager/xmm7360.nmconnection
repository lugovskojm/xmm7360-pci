[connection]
id=xmm7360
uuid=e7360000-0000-4000-a000-7360c6e11ec7
type=ethernet
interface-name=wwan0
autoconnect=false

[ethernet]

# method=disabled: NM won't touch IPv4 on wwan0. xmm7360-up.sh owns
# the address, routes, and policy routing. Using 'manual' here would
# require ipv4.addresses= and fight with our helper.
[ipv4]
method=disabled

[ipv6]
method=disabled
