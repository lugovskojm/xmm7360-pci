[connection]
id=xmm7360
uuid=e7360000-0000-4000-a000-7360c6e11ec7
# 'generic' matches raw-IP POINTOPOINT/NOARP interfaces like wwan0;
# 'ethernet' would be rejected by NM as "not compatible with device".
type=generic
interface-name=wwan0
autoconnect=false

[generic]

# method=disabled: NM won't touch IPv4/IPv6 on wwan0. xmm7360-up.sh owns
# the address, routes, and policy routing.
[ipv4]
method=disabled

[ipv6]
method=disabled
